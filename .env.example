# Copie para .env e ajuste os valores. Nunca versione o arquivo .env.
NODE_ENV=development
PORT=3000

# URL pública do sistema. Usada para montar os links de contrato e formulário enviados ao cliente.
# No Vercel pode ficar vazia: o sistema usa o domínio do projeto automaticamente.
APP_URL=http://localhost:3000

# Banco de dados.
# Local: deixe TURSO_DATABASE_URL vazio e o sistema usa o arquivo SQLite em DB_PATH.
# Vercel/produção: crie um banco no Turso (turso.tech) e preencha as duas variáveis abaixo.
DB_PATH=./data/erp.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Usuário administrador criado na primeira execução (se não houver nenhum usuário).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e exibida uma única vez no console.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=

# Tempo de vida da sessão (horas sem atividade)
SESSION_TTL_HOURS=8

# Use 1 quando o sistema estiver atrás de um proxy reverso (Nginx, Cloudflare etc.)
TRUST_PROXY=0

# WhatsApp Cloud API (Meta). Opcional: sem essas variáveis o sistema usa links wa.me.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
