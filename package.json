{
  "name": "eventos-erp-crm",
  "version": "1.0.0",
  "description": "ERP + CRM para empresas de eventos: agenda, unidades, financeiro, estoque, contratos, funil de vendas e WhatsApp.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed:demo": "node --env-file-if-exists=.env src/db/seed-demo.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
